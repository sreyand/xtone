<Window x:Class="XTONE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:XTONE.Controls"
        xmlns:services="clr-namespace:XTONE.Services"
        xmlns:views="clr-namespace:XTONE.Views"
        Title="XTONE" Width="1280" Height="820" MinWidth="960" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource PaperBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="14" Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged" AllowDrop="True" PreviewDragOver="Music_DragOver" PreviewDrop="Music_Drop" DragLeave="Music_DragLeave">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="8" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,6"/><Setter Property="Height" Value="32"/>
        </Style>
        <Style x:Key="TrackItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource RowSelectionBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrackList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource TrackItem}"/>
        </Style>
        <ContextMenu x:Key="TrackMenu" x:Shared="False" DataContext="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Play" Click="TrackPlay_Click" Tag="{Binding}"/>
            <MenuItem Header="Play next" Click="TrackNext_Click" Tag="{Binding}"/>
            <MenuItem Header="Add to queue" Click="TrackQueue_Click" Tag="{Binding}"/>
            <Separator/>
            <MenuItem Header="Toggle favorite" Click="TrackFavorite_Click" Tag="{Binding}"/>
            <MenuItem Header="File details…" Click="TrackDetails_Click" Tag="{Binding}"/>
            <MenuItem Header="Locate file…" Click="TrackRelink_Click" Tag="{Binding}"/>
        </ContextMenu>
        <DataTemplate x:Key="TrackRowTemplate">
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,10" ToolTip="{Binding Path}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <DockPanel><TextBlock Text="♥" Foreground="{DynamicResource BlueBrush}" Margin="0,0,7,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/></DockPanel>
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource OptionalArtistCaption}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Availability}" Foreground="{DynamicResource ErrorBrush}" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding DurationText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AlbumCardTemplate">
            <Button Tag="{Binding}" Click="AlbumCard_Click" Cursor="Hand" Background="Transparent" Padding="0" Margin="0,0,20,24"
                    services:UiMotion.Hover="True" controls:FluidLayout.IsEnabled="True" controls:FluidLayout.Key="{Binding Id}"
                    controls:FluidLayout.Scope="{Binding RelativeSource={RelativeSource AncestorType=ListBox}}"
                    BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" AutomationProperties.Name="{Binding Title}">
                <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Play album" Click="AlbumPlay_Click" Tag="{Binding}"/>
                    <MenuItem Header="Add album to queue" Click="AlbumQueue_Click" Tag="{Binding}"/>
                    <MenuItem Header="Edit / make personal album…" Click="AlbumEdit_Click" Tag="{Binding}"/>
                </ContextMenu></Button.ContextMenu>
                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="Transparent" CornerRadius="6" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Button.Template>
                <StackPanel><controls:AlbumArtwork Source="{Binding Artwork}" SourcePath="{Binding ArtworkPath}" FallbackBrush="{Binding CoverBrush}"/>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Artist}" Style="{StaticResource OptionalArtistCaption}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="ShellBorder" Background="{DynamicResource PaperBrush}" BorderBrush="#DDE0E5" BorderThickness="1" CornerRadius="7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="PlayerDockRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="#E8E9EC" BorderThickness="0,0,1,0" Background="{DynamicResource PaperBrush}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Bottom" Margin="24,12,24,20">
                            <TextBlock x:Name="FolderSummary" Visibility="Collapsed"/>
                            <Button Content="Settings" Click="Settings_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" FontSize="12" Padding="8,10" ToolTip="Settings · Ctrl+,"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SidebarContents" Margin="14,38,14,16">
                                <Rectangle Width="128" Height="35" HorizontalAlignment="Left" Margin="12,0,0,30">
                                    <Rectangle.Fill><ImageBrush ImageSource="Assets/xtone-logo.png" Stretch="Uniform" Viewbox="0.16,0.414,0.675,0.172" ViewboxUnits="RelativeToBoundingBox"/></Rectangle.Fill>
                                </Rectangle>
                                <Button x:Name="LibraryNav" Content="Library" Tag="Library" Click="Section_Click" Style="{StaticResource NavButton}"/>
                                <Button x:Name="AlbumsNav" Content="Albums" Tag="Albums" Click="Section_Click" Style="{StaticResource NavButton}" Visibility="Collapsed"/>
                                <Button x:Name="PlaylistsNav" Content="Playlists" Tag="Playlists" Click="Section_Click" Style="{StaticResource NavButton}" Visibility="Collapsed"/>
                                <StackPanel x:Name="DiscoveryNavigation" Margin="0" Visibility="Collapsed">
                                    <Button x:Name="ArtistsNav" Content="Artists" Tag="Artists" Click="Section_Click" Style="{StaticResource NavButton}"/>
                                    <Button x:Name="FavoritesNav" Content="Favorites" Tag="Favorites" Click="Section_Click" Style="{StaticResource NavButton}"/>
                                    <Button x:Name="HistoryNav" Content="Recently played" Tag="History" Click="Section_Click" Style="{StaticResource NavButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Grid x:Name="MainContent" Grid.Column="1" Margin="36,44,32,20">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="MainHeaderRow" Height="64" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="PageHeader" Grid.Row="0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="PageTitle" Text="Albums" FontSize="32" FontWeight="Bold" LineHeight="42" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,24,0"/>
                        <TextBlock x:Name="PageSubtitle" Visibility="Collapsed"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SearchToolbarButton" Click="Search_Click" Style="{StaticResource QuietButton}" Width="34" Height="34" Padding="9" ToolTip="Search · Ctrl+F" AutomationProperties.Name="Search library">
                                <Path Data="{StaticResource SearchIcon}" Style="{StaticResource IconPath}" Width="16" Height="16"/>
                            </Button>
                            <Button x:Name="HeaderAddMusicButton" Content="Add music" Click="AddMusic_Click" Style="{StaticResource QuietButton}" Height="34" Margin="8,0,4,0" FontSize="12"/>
                            <Button x:Name="HeaderMoreButton" Content="⋯" FontSize="20" Click="HeaderMore_Click" Style="{StaticResource QuietButton}" Width="34" Height="34" Padding="4" ToolTip="Library options" AutomationProperties.Name="Library options">
                                <Button.ContextMenu><ContextMenu>
                                    <MenuItem Header="Create album…" Click="CreateAlbum_Click"/>
                                    <MenuItem Header="Create playlist…" Click="CreatePlaylist_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="HeaderQueueMenu" Header="Queue" Click="Queue_Click" Visibility="Collapsed"/>
                                    <MenuItem Header="Rescan folders" Click="Rescan_Click"/>
                                </ContextMenu></Button.ContextMenu>
                            </Button>
                            <Button x:Name="QueueToolbarButton" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="LibraryToolbar" Grid.Row="1" Margin="0,0,0,20" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid x:Name="SearchControlsPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Visibility="Collapsed" Style="{StaticResource TextInput}" Height="36" Margin="0,0,16,0" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search library"/>
                            <TextBlock Text="Search your music…" Margin="12,0,24,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="13" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/><Condition Binding="{Binding Visibility, ElementName=SearchBox}" Value="Visible"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <ComboBox x:Name="ViewFilter" Grid.Column="1" Width="132" Height="36" SelectedIndex="0" SelectionChanged="Filter_Changed" Visibility="Collapsed" AutomationProperties.Name="Filter tracks" Margin="0,0,8,0">
                                <ComboBoxItem Content="All music" Tag="all"/><ComboBoxItem Content="Lossless" Tag="lossless"/><ComboBoxItem Content="Unplayed" Tag="unplayed"/><ComboBoxItem Content="Missing / errors" Tag="missing"/>
                            </ComboBox>
                            <ComboBox x:Name="SortPicker" Grid.Column="2" Width="125" Height="36" SelectedIndex="0" SelectionChanged="Filter_Changed" Visibility="Collapsed" AutomationProperties.Name="Sort tracks">
                                <ComboBoxItem Content="Title" Tag="title"/><ComboBoxItem Content="Artist" Tag="artist"/><ComboBoxItem Content="Album" Tag="album"/><ComboBoxItem Content="Recently added" Tag="added"/>
                            </ComboBox>
                        </Grid>
                        <Grid x:Name="ImportStatusPanel" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock x:Name="ScanStatus" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                                <ProgressBar x:Name="ScanProgress" Visibility="Collapsed" Height="2" Margin="0,8,0,0" Foreground="{DynamicResource BlueBrush}"/>
                            </StackPanel>
                            <Button x:Name="RetryLoadButton" Grid.Column="1" Content="Try again" Click="RetryLibrary_Click" Style="{StaticResource SmallButton}" Visibility="Collapsed"/>
                            <Button x:Name="ScanCancelButton" Grid.Column="1" Content="Cancel" Click="CancelScan_Click" Style="{StaticResource SmallButton}" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid x:Name="AlbumScroll">
                            <ListBox x:Name="AlbumItems" Style="{StaticResource TrackList}" SizeChanged="AlbumViewport_SizeChanged" AutomationProperties.Name="Albums">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding Albums}" ItemTemplate="{StaticResource AlbumCardTemplate}" Margin="0,0,-20,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <StackPanel x:Name="EmptyState" Panel.ZIndex="2" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" Margin="24,0,24,24">
                            <TextBlock x:Name="EmptyHeadline" Text="Your music, here." FontSize="26" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="EmptyDescription" Text="Add files or a folder to start listening." TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="13" LineHeight="21" Margin="0,12,0,24"/>
                            <Button x:Name="CreateButton" Content="Create playlist" Click="CreateCollection_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
                            <Button x:Name="EmptyAddMusicButton" Content="Add music" Click="AddMusic_Click" Style="{StaticResource PrimaryButton}" Width="136" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DropMusicHint" Text="Or drop files or folders here" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <ProgressBar x:Name="WelcomeProgress" Width="260" Height="3" Margin="0,0,0,16" Visibility="Collapsed" Foreground="{DynamicResource BlueBrush}"
                                         IsIndeterminate="{Binding IsIndeterminate, ElementName=ScanProgress}" Maximum="{Binding Maximum, ElementName=ScanProgress}" Value="{Binding Value, ElementName=ScanProgress}"/>
                            <Button x:Name="WelcomeRetryButton" Content="Try again" Click="RetryLibrary_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Width="136" Visibility="Collapsed"/>
                            <Button x:Name="WelcomeCancelButton" Content="Cancel" Click="CancelScan_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Center" Visibility="Collapsed"/>
                            <Button x:Name="ClearResultsButton" Content="Clear search and filters" Click="ClearResults_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>

                        <Grid x:Name="LibraryPanel" Visibility="Collapsed">
                            <ListBox x:Name="LibraryTracks" Margin="-10,0,-10,0" Style="{StaticResource TrackList}" ItemTemplate="{StaticResource TrackRowTemplate}" ContextMenu="{StaticResource TrackMenu}"
                                     MouseDoubleClick="Tracks_MouseDoubleClick" KeyDown="Tracks_KeyDown" PreviewMouseRightButtonDown="Track_RightClick" AutomationProperties.Name="Library tracks"/>
                        </Grid>

                        <Grid x:Name="AlbumDetailPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <controls:AlbumArtwork x:Name="DetailArtwork" Width="148" Height="148" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Margin="24,3,0,0">
                                    <TextBlock x:Name="DetailTitle" FontSize="26" FontWeight="Bold" />
                                    <TextBlock x:Name="DetailArtist" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Style="{StaticResource OptionalArtistCaption}" Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,5,0,0" />
                                    <TextBlock x:Name="DetailMeta" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,7,0,0" />
                                    <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"><TextBlock x:Name="DetailNotes" Foreground="{DynamicResource MutedBrush}" FontSize="14" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" /></ScrollViewer>
                                    <StackPanel Orientation="Horizontal" Margin="-10,8,0,0">
                                        <Button Content="← Back" Click="BackToAlbums_Click" Style="{StaticResource SmallButton}"/>
                                        <Button Content="Play" Click="PlayCollection_Click" Style="{StaticResource SmallButton}"/>
                                        <Button x:Name="EditCollectionButton" Content="Edit" Click="EditCollection_Click" Style="{StaticResource SmallButton}"/>
                                        <Button x:Name="DeleteCollectionButton" Content="Delete collection" Click="DeleteCollection_Click" Style="{StaticResource SmallButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="DetailEmptyState" Grid.Row="1" Text="No tracks in this collection yet." Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
                            <ListBox x:Name="DetailTracks" Grid.Row="1" Margin="-10,0,-10,0" Style="{StaticResource TrackList}" ItemTemplate="{StaticResource TrackRowTemplate}" ContextMenu="{StaticResource TrackMenu}"
                                     MouseDoubleClick="Tracks_MouseDoubleClick" KeyDown="Tracks_KeyDown" PreviewMouseRightButtonDown="Track_RightClick" AutomationProperties.Name="Collection tracks"/>
                        </Grid>

                        <ScrollViewer x:Name="ArtistsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ArtistItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="Artist_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid x:Name="PlaylistsPanel" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PlaylistItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="Playlist_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding TrackCountText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="PlaylistEmptyState" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Border x:Name="PlayerDock" Grid.Row="1" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                <Grid Margin="24,10,24,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="170" MaxWidth="260"/><ColumnDefinition Width="3*" MinWidth="280"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <controls:AlbumArtwork x:Name="NowPlayingArtwork" Width="48" Height="48"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NowPlayingTitle" Text="Choose a track" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="NowPlayingArtist" Style="{StaticResource OptionalArtistCaption}" Text="Your local music" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1" Margin="8,0,24,0">
                        <Grid.RowDefinitions><RowDefinition x:Name="VisualizerRow" Height="0"/><RowDefinition x:Name="TransportRow" Height="48"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                        <controls:SignalVisualizer x:Name="Visualizer" Height="0" Visibility="Collapsed"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="ShuffleButton" Click="Shuffle_Click" Style="{StaticResource TransportButton}" Margin="0,0,8,0" ToolTip="Shuffle" AutomationProperties.Name="Shuffle"><Path Data="{StaticResource ShuffleIcon}" Style="{StaticResource IconPath}" Width="16" Height="16"/></Button>
                            <Button Click="Previous_Click" Style="{StaticResource TransportButton}" Margin="0,0,10,0" ToolTip="Previous track" AutomationProperties.Name="Previous track"><Path Data="{StaticResource PreviousIcon}" Fill="{DynamicResource InkBrush}" Width="16" Height="16" Stretch="Uniform"/></Button>
                            <Button x:Name="PlayPauseButton" Click="PlayPause_Click" Style="{StaticResource PlayButton}" Width="42" Height="42" AutomationProperties.Name="Play or pause">
                                <Grid Width="18" Height="20"><Path x:Name="PlayGlyph" Data="{StaticResource PlayIcon}" Fill="{DynamicResource AccentTextBrush}" Stretch="Uniform" Margin="3,2,0,2"/><Path x:Name="PauseGlyph" Data="{StaticResource PauseIcon}" Fill="{DynamicResource AccentTextBrush}" Stretch="Uniform" Margin="2" Visibility="Collapsed"/></Grid>
                            </Button>
                            <Button Click="Next_Click" Style="{StaticResource TransportButton}" Margin="10,0,0,0" ToolTip="Next track" AutomationProperties.Name="Next track"><Path Data="{StaticResource NextIcon}" Fill="{DynamicResource InkBrush}" Width="16" Height="16" Stretch="Uniform"/></Button>
                            <Button x:Name="RepeatButton" Click="Repeat_Click" Style="{StaticResource TransportButton}" Margin="8,0,0,0" ToolTip="Repeat" AutomationProperties.Name="Repeat"><Path Data="{StaticResource RepeatIcon}" Style="{StaticResource IconPath}" Width="17" Height="17"/></Button>
                        </StackPanel>
                        <Grid Grid.Row="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" Text="0:00" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <views:ListeningSlider x:Name="PositionSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Style="{StaticResource SeekSlider}" PreviewMouseDown="PositionSlider_MouseDown" PreviewMouseLeftButtonUp="PositionSlider_MouseUp" PreviewKeyUp="PositionSlider_KeyUp" AutomationValueCommitted="MainSeek_AutomationCommitted" AutomationProperties.Name="Playback position"/>
                            <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition x:Name="QualitySpacerRow" Height="0"/><RowDefinition x:Name="QualityInfoRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock x:Name="QualityText" Text="Local audio" Visibility="Collapsed"/>
                        <Grid Grid.Row="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource VolumeIcon}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.6" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"/>
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Margin="8,0,12,0" Minimum="0" Maximum="1" Value="0.72" Style="{StaticResource VolumeSlider}" ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.Name="Volume"/>
                            <Button Grid.Column="2" Content="⋯" FontSize="20" Style="{StaticResource QuietButton}" Padding="4" Width="32" Height="32" Click="PlayerMore_Click" ToolTip="Playback options" AutomationProperties.Name="Playback options">
                                <Button.ContextMenu><ContextMenu><MenuItem Header="Queue" Click="Queue_Click"/><Separator/><MenuItem Header="Focus mode" Click="FocusMode_Click"/><MenuItem Header="Mini-player" Click="MiniPlayer_Click"/><Separator/><MenuItem Header="File details…" Click="NowPlayingDetails_Click"/></ContextMenu></Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="QueuePanel" Grid.Row="0" Panel.ZIndex="8" Visibility="Collapsed" HorizontalAlignment="Right" Width="390" Margin="0,52,18,12" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Queue" FontSize="22" FontWeight="Bold"/><Button Content="Close" Click="Queue_Click" Style="{StaticResource SmallButton}" HorizontalAlignment="Right"/></Grid>
                    <ListBox x:Name="QueueItems" Grid.Row="1" Margin="0,16,0,12" Style="{StaticResource TrackList}" AllowDrop="True" PreviewMouseLeftButtonDown="Queue_MouseDown" MouseMove="Queue_MouseMove" Drop="Queue_Drop" KeyDown="Queue_KeyDown" AutomationProperties.Name="Playback queue">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource TrackItem}"><Setter Property="AutomationProperties.Name" Value="{Binding Track.Title}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,10"><TextBlock Text="{Binding Track.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Track.Artist}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="Now playing" FontSize="10" Foreground="{DynamicResource BlueBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2"><Button Content="Play" Click="QueuePlay_Click" Style="{StaticResource SmallButton}"/><Button Content="↑" Click="QueueUp_Click" Style="{StaticResource SmallButton}" AutomationProperties.Name="Move queued track up"/><Button Content="↓" Click="QueueDown_Click" Style="{StaticResource SmallButton}" AutomationProperties.Name="Move queued track down"/><Button Content="Remove" Click="QueueRemove_Click" Style="{StaticResource SmallButton}"/><Button Content="Clear others" Click="QueueClear_Click" Style="{StaticResource SmallButton}"/></WrapPanel>
                </Grid>
            </Border>

            <Border x:Name="NoticePanel" Grid.Row="0" Panel.ZIndex="10" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="460" Margin="24,0,24,18" Padding="14,8" CornerRadius="6" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Visibility="Collapsed">
                <DockPanel><Button DockPanel.Dock="Right" Content="×" Click="DismissNotice_Click" Style="{StaticResource QuietButton}" Width="28" Height="28" Padding="4" Margin="12,0,0,0" AutomationProperties.Name="Dismiss notification"/><TextBlock x:Name="NoticeText" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></DockPanel>
            </Border>
            <Border x:Name="MusicDropOverlay" Grid.Row="0" Panel.ZIndex="9" Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource BlueBrush}" BorderThickness="1" CornerRadius="6" Margin="240,60,24,24" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Text="Drop music to add it" Foreground="{DynamicResource InkBrush}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Panel.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,0,1,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Click="Minimize_Click" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Minimize">
                    <Path Data="M0,5 H12" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" />
                </Button>
                <Button Click="Maximize_Click" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Maximize">
                    <Path x:Name="MaximizeGlyph" Data="M0,0 H11 V11 H0 Z" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" />
                </Button>
                <Button Click="Close_Click" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Close">
                    <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="XTONE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:XTONE.Controls"
        Title="XTONE" Width="1536" Height="940" MinWidth="1060" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResize" Background="White"
        FontFamily="{StaticResource AppFont}" FontSize="16" Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="8" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="TrackRowTemplate">
            <Border BorderBrush="#EEEEF0" BorderThickness="0,0,0,1" Padding="12,13" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding QualitySummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding DetailSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="ShellBorder" Background="White" BorderBrush="#DDE0E5" BorderThickness="1" CornerRadius="7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="176" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="276" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="#E8E9EC" BorderThickness="0,0,1,0" Background="#FFFFFF">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,54,12,0">
                        <Rectangle Width="160" Height="43" HorizontalAlignment="Left" Margin="14,0,0,29">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="Assets/xtone-logo.png" Stretch="Uniform"
                                            Viewbox="0.16,0.414,0.675,0.172" ViewboxUnits="RelativeToBoundingBox" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Button x:Name="LibraryNav" Tag="Library" Click="Section_Click" Style="{StaticResource NavButton}" AutomationProperties.Name="Library">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource LibraryIcon}" Style="{StaticResource IconPath}" Margin="0,0,20,0" />
                                <TextBlock Text="Library" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AlbumsNav" Tag="Albums" Click="Section_Click" Style="{StaticResource NavButton}" Background="#EFF3FF" Foreground="{StaticResource BlueBrush}" FontWeight="SemiBold" AutomationProperties.Name="Albums">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource AlbumIcon}" Width="29" Height="29" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="-2,0,17,0" />
                                <TextBlock Text="Albums" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ArtistsNav" Tag="Artists" Click="Section_Click" Style="{StaticResource NavButton}" AutomationProperties.Name="Artists">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ArtistsIcon}" Style="{StaticResource IconPath}" Margin="0,0,20,0" />
                                <TextBlock Text="Artists" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlaylistsNav" Tag="Playlists" Click="Section_Click" Style="{StaticResource NavButton}" AutomationProperties.Name="Playlists">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource PlaylistIcon}" Style="{StaticResource IconPath}" Margin="0,0,20,0" />
                                <TextBlock Text="Playlists" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Height="1" Background="#E4E6EA" Margin="10,27,10,37" />
                        <TextBlock Text="LOCAL MUSIC" Foreground="#83868B" FontSize="12" Margin="15,0,0,16" />
                        <Button Click="ImportFolder_Click" Style="{StaticResource NavButton}" Height="40" FontSize="18" ToolTip="Choose your local music folder" AutomationProperties.Name="Music folder">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FolderIcon}" Style="{StaticResource IconPath}" Margin="0,0,20,0" />
                                <TextBlock x:Name="FolderSummary" Text="Music folder" VerticalAlignment="Center" MaxWidth="157" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button Click="ImportFolder_Click" Style="{StaticResource QuietButton}" BorderBrush="#D9DDE4" Margin="9,12,9,0" Height="52" HorizontalContentAlignment="Left" FontSize="18" AutomationProperties.Name="Add music">
                            <Button.ContextMenu><ContextMenu><MenuItem Header="Add audio files…" Click="ImportFiles_Click" /></ContextMenu></Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource PlusIcon}" Style="{StaticResource IconPath}" Margin="1,0,25,0" StrokeThickness="1.4" />
                                <TextBlock Text="Add music" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1" Margin="42,68,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="110" />
                        <RowDefinition Height="47" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,-2,20,0">
                            <TextBlock x:Name="PageTitle" Text="Albums" FontSize="64" FontWeight="Black" LineHeight="80" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PageSubtitle" Text="0 tracks · 0 albums" Foreground="{StaticResource MutedBrush}" FontSize="20" Margin="2,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CreateButton" Content="Create album" Click="CreateAlbum_Click" Style="{StaticResource PrimaryButton}" Width="182" Margin="0,0,12,0" />
                                <Button Content="Import folder" Click="ImportFolder_Click" Style="{StaticResource QuietButton}" BorderBrush="#D5D9E1" Width="188" Height="50" FontSize="18" />
                            </StackPanel>
                            <TextBox x:Name="SearchBox" Visibility="Collapsed" Style="{StaticResource TextInput}" Height="36" Margin="0,10,0,0"
                                     ToolTip="Search albums, artists and tracks · Escape to close" AutomationProperties.Name="Search library" TextChanged="SearchBox_TextChanged" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="AlbumScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,1,0">
                            <ItemsControl x:Name="AlbumItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><controls:ResponsiveAlbumPanel Gap="24" RowGap="30" TargetCardWidth="264" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="AlbumCard_Click" Cursor="Hand" Background="Transparent" Padding="0"
                                                BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                                AutomationProperties.Name="{Binding Title}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Card" Background="Transparent" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.88" /></Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="Background" Value="#EFF3FF" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <controls:AlbumArtwork Source="{Binding Artwork}" FallbackBrush="{Binding CoverBrush}" />
                                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Artist}" FontSize="18" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" Margin="0,0,0,45">
                            <Path Data="{StaticResource LibraryIcon}" Stroke="#255BFF" StrokeThickness="1.3" Width="46" Height="48" Stretch="Uniform" Margin="0,0,0,24" />
                            <TextBlock Text="Your albums, in one place." FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyDescription" Text="Add a music folder to start your collection." TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="16" Margin="0,11,0,24" />
                            <Button Content="Add music" Click="ImportFolder_Click" Style="{StaticResource PrimaryButton}" Width="155" />
                        </StackPanel>

                        <Grid x:Name="LibraryPanel" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="LibraryTracks" ItemTemplate="{StaticResource TrackRowTemplate}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter"><EventSetter Event="MouseLeftButtonDown" Handler="TrackRow_MouseLeftButtonDown" /></Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Grid x:Name="AlbumDetailPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <controls:AlbumArtwork x:Name="DetailArtwork" Width="148" Height="148" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Margin="24,3,0,0">
                                    <TextBlock x:Name="DetailTitle" FontSize="26" FontWeight="Bold" />
                                    <TextBlock x:Name="DetailArtist" Foreground="{StaticResource MutedBrush}" FontSize="17" Margin="0,5,0,0" />
                                    <TextBlock x:Name="DetailMeta" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,7,0,0" />
                                    <TextBlock x:Name="DetailNotes" Foreground="#55585D" FontSize="14" TextWrapping="Wrap" MaxWidth="620" Margin="0,12,0,0" HorizontalAlignment="Left" />
                                    <Button Content="←  Back" Click="BackToAlbums_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="-16,4,0,0" />
                                </StackPanel>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DetailTracks" ItemTemplate="{StaticResource TrackRowTemplate}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter"><EventSetter Event="MouseLeftButtonDown" Handler="TrackRow_MouseLeftButtonDown" /></Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <ScrollViewer x:Name="ArtistsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ArtistItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="Artist_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="14,20">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,20,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{StaticResource MutedBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid x:Name="PlaylistsPanel" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PlaylistItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="Playlist_Click" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Stretch" Padding="14,20">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,20,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding TrackCountText}" Foreground="{StaticResource MutedBrush}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="PlaylistEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,45">
                                <TextBlock Text="Keep a few favorites together." FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Playlists are saved on this PC." Foreground="{StaticResource MutedBrush}" FontSize="16" Margin="0,11,0,24" HorizontalAlignment="Center" />
                                <Button Content="Create a playlist" Click="CreatePlaylist_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Background="White" BorderBrush="#E4E6EA" BorderThickness="0,1,0,0">
                <Grid Margin="26,0,28,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="278" /><ColumnDefinition Width="*" /><ColumnDefinition Width="254" /></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <controls:AlbumArtwork x:Name="NowPlayingArtwork" Width="88" Height="88" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NowPlayingTitle" Text="Choose a track" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NowPlayingArtist" Text="Your local music" FontSize="18" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1" Margin="12,0,14,0">
                        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="68" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <controls:SignalVisualizer x:Name="Visualizer" Grid.Row="0" Height="58" IsHitTestVisible="False" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="ShuffleButton" Click="Shuffle_Click" Style="{StaticResource TransportButton}" Margin="0,0,13,0" ToolTip="Shuffle" AutomationProperties.Name="Shuffle">
                                <Path Data="{StaticResource ShuffleIcon}" Style="{StaticResource IconPath}" Width="23" Height="23" StrokeThickness="1.8" />
                            </Button>
                            <Button Click="Previous_Click" Style="{StaticResource TransportButton}" Margin="0,0,14,0" ToolTip="Previous track" AutomationProperties.Name="Previous track">
                                <Path Data="{StaticResource PreviousIcon}" Fill="{StaticResource InkBrush}" Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="PlayPauseButton" Click="PlayPause_Click" Style="{StaticResource PlayButton}" ToolTip="Play" AutomationProperties.Name="Play or pause">
                                <Grid Width="26" Height="28">
                                    <Path x:Name="PlayGlyph" Data="{StaticResource PlayIcon}" Fill="White" Stretch="Uniform" Margin="3,2,0,2" />
                                    <Path x:Name="PauseGlyph" Data="{StaticResource PauseIcon}" Fill="White" Stretch="Uniform" Margin="2,2" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                            <Button Click="Next_Click" Style="{StaticResource TransportButton}" Margin="14,0,0,0" ToolTip="Next track" AutomationProperties.Name="Next track">
                                <Path Data="{StaticResource NextIcon}" Fill="{StaticResource InkBrush}" Width="22" Height="22" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="RepeatButton" Click="Repeat_Click" Style="{StaticResource TransportButton}" Margin="13,0,0,0" ToolTip="Repeat track" AutomationProperties.Name="Repeat track">
                                <Path Data="{StaticResource RepeatIcon}" Style="{StaticResource IconPath}" Width="24" Height="24" StrokeThickness="1.7" />
                            </Button>
                        </StackPanel>
                        <Grid Grid.Row="2" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" Text="0:00" FontSize="16" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            <Slider x:Name="PositionSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Style="{StaticResource SeekSlider}"
                                    PreviewMouseDown="PositionSlider_MouseDown" PreviewMouseLeftButtonUp="PositionSlider_MouseUp"
                                    PreviewKeyUp="PositionSlider_KeyUp" AutomationProperties.Name="Playback position" />
                            <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="16" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Column="2" Margin="14,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="68" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock x:Name="QualityText" Grid.Row="1" Text="Local audio" Foreground="#686B72" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource VolumeIcon}" Stroke="#151515" StrokeThickness="1.8" Width="23" Height="23" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.72" Style="{StaticResource VolumeSlider}" ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.Name="Volume" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Panel.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,0,1,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Click="Minimize_Click" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Minimize">
                    <Path Data="M0,5 H12" Stroke="#161616" StrokeThickness="1" />
                </Button>
                <Button Click="Maximize_Click" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Maximize">
                    <Path x:Name="MaximizeGlyph" Data="M0,0 H11 V11 H0 Z" Stroke="#161616" StrokeThickness="1" />
                </Button>
                <Button Click="Close_Click" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Close">
                    <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="#161616" StrokeThickness="1" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="XTONE.Views.FocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:XTONE.Controls"
        xmlns:views="clr-namespace:XTONE.Views"
        Icon="/XTONE;component/Assets/xtone.ico" Title="XTONE · Focus" Width="920" Height="820" MinWidth="640" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PaperBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="15"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="8" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="FocusSmallButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Height" Value="38"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusStyle}"/>
        </Style>
        <Style x:Key="FocusIconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocusStyle}"/>
        </Style>
        <Style x:Key="FocusPlayButton" TargetType="Button" BasedOn="{StaticResource PlayButton}">
            <Setter Property="Width" Value="52"/><Setter Property="Height" Value="52"/>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" CornerRadius="7">
        <Grid>
            <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid Margin="24,0,12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="xTONE" FontWeight="Black" FontSize="24" AutomationProperties.Name="XTONE focus view"/>
                    <TextBlock Text="FOCUS" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="15,6,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="Library" Style="{StaticResource FocusSmallButton}" Click="Library_Click" ToolTip="Return to library (Ctrl+L)" AutomationProperties.Name="Return to library"/>
                    <Button Content="Mini" Style="{StaticResource FocusSmallButton}" Click="Mini_Click" ToolTip="Open mini player (Ctrl+M)" AutomationProperties.Name="Open mini player"/>
                    <Button Content="Queue" Style="{StaticResource FocusSmallButton}" Click="Queue_Click" ToolTip="Open playback queue (Ctrl+Q)" AutomationProperties.Name="Open playback queue"/>
                    <Button x:Name="FullScreenButton" Style="{StaticResource FocusIconButton}" Margin="6,0,0,0" Click="FullScreen_Click" ToolTip="Full screen (F11)" AutomationProperties.Name="Enter full screen">
                        <Path x:Name="FullScreenGlyph" Data="M1,7 V1 H7 M15,1 H21 V7 M21,15 V21 H15 M7,21 H1 V15" Style="{StaticResource IconPath}" Width="17" Height="17"/>
                    </Button>
                    <Button Style="{StaticResource FocusIconButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize focus view">
                        <Path Data="M2,12 H20" Style="{StaticResource IconPath}" Width="14" Height="14"/>
                    </Button>
                    <Button Style="{StaticResource FocusIconButton}" Click="Close_Click" ToolTip="Return to library" AutomationProperties.Name="Close focus view and return to library">
                        <Path Data="M3,3 L19,19 M3,19 L19,3" Style="{StaticResource IconPath}" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="HeroScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          VerticalContentAlignment="Center" Focusable="False" Padding="28,8,28,18" SizeChanged="Window_SizeChanged">
                <StackPanel x:Name="HeroContent" MaxWidth="660" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="PlaybackCaption" Text="{Binding PlaybackLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"/>
                    <Grid x:Name="ArtworkHost" Width="360" Height="360" HorizontalAlignment="Center">
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7">
                            <controls:AlbumArtwork Source="{Binding Artwork}" SourcePath="{Binding ArtworkPath}" FallbackBrush="{Binding CoverBrush}">
                                <controls:AlbumArtwork.Style><Style TargetType="controls:AlbumArtwork"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasTrack}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></controls:AlbumArtwork.Style>
                            </controls:AlbumArtwork>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasTrack}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="xTONE" FontWeight="Black" FontSize="32" HorizontalAlignment="Center"/>
                                <TextBlock Text="YOUR LOCAL MUSIC" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="MetadataPanel" Margin="0,20,0,0">
                        <TextBlock x:Name="TrackTitle" Text="{Binding Title}" FontSize="28" FontWeight="Bold" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="650" ToolTip="{Binding Title}"/>
                        <TextBlock x:Name="TrackArtist" Text="{Binding Artist}" Style="{StaticResource OptionalArtistCaption}" FontSize="14" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Artist}"/>
                        <TextBlock x:Name="TrackAlbum" Text="{Binding Album}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Album}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Album}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <controls:SignalVisualizer x:Name="Visualizer" Height="64" Margin="0,10,0,0" IsHitTestVisible="False" Focusable="False"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="PlaybackControls" Grid.Row="2" Width="660" HorizontalAlignment="Center" Margin="28,0,28,18">
                    <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,28,0" Style="{StaticResource FocusIconButton}"
                                Click="Favorite_Click" IsEnabled="{Binding HasTrack}" ToolTip="{Binding FavoriteLabel}" AutomationProperties.Name="{Binding FavoriteLabel}">
                            <Path Data="M12,21 L3,12 C-3,6 5,-1 12,6 C19,-1 27,6 21,12 Z" Width="23" Height="22" Stretch="Uniform" StrokeThickness="1.6">
                                <Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="{DynamicResource InkBrush}"/><Setter Property="Fill" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Stroke" Value="{DynamicResource BlueBrush}"/><Setter Property="Fill" Value="{DynamicResource BlueBrush}"/></DataTrigger></Style.Triggers></Style></Path.Style>
                            </Path>
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource FocusIconButton}" Click="Previous_Click" Margin="0,0,18,0" IsEnabled="{Binding HasTrack}"
                                    ToolTip="Previous track (Ctrl+Left)" AutomationProperties.Name="Previous track">
                                <Path Data="{StaticResource PreviousIcon}" Fill="{DynamicResource InkBrush}" Width="21" Height="21" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource FocusPlayButton}" Click="PlayPause_Click"
                                    ToolTip="{Binding PlayPauseLabel}" AutomationProperties.Name="{Binding PlayPauseLabel}">
                                <Grid Width="24" Height="27">
                                    <Path Data="{StaticResource PlayIcon}" Fill="{DynamicResource AccentTextBrush}" Stretch="Uniform" Margin="4,1,0,1">
                                        <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsOpening}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Path.Style>
                                    </Path>
                                    <Path Data="{StaticResource PauseIcon}" Fill="{DynamicResource AccentTextBrush}" Stretch="Uniform" Margin="2,2">
                                        <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsOpening}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Path.Style>
                                    </Path>
                                    <Path Data="M4,5 L20,21 M4,21 L20,5" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2" Stretch="Uniform" Margin="4">
                                        <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOpening}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
                                    </Path>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource FocusIconButton}" Click="Next_Click" Margin="18,0,0,0" IsEnabled="{Binding HasTrack}"
                                    ToolTip="Next track (Ctrl+Right)" AutomationProperties.Name="Next track">
                                <Path Data="{StaticResource NextIcon}" Fill="{DynamicResource InkBrush}" Width="21" Height="21" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="SeekPanel" Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                        <views:ListeningSlider x:Name="SeekSlider" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="{Binding SeekMaximum}"
                                Value="{Binding PositionSeconds, Mode=OneWay}" IsEnabled="{Binding CanSeek}"
                                SmallChange="5" LargeChange="15" AutomationProperties.Name="Track position in seconds"
                                ToolTip="Seek through the current track"
                                PreviewMouseLeftButtonDown="Seek_MouseDown" PreviewMouseLeftButtonUp="Seek_MouseUp"
                                PreviewKeyDown="Seek_KeyDown" PreviewKeyUp="Seek_KeyUp" LostKeyboardFocus="Seek_LostKeyboardFocus"
                                AutomationValueCommitted="Seek_AutomationValueCommitted"/>
                        <TextBlock Grid.Row="1" Text="{Binding ElapsedText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Grid.Row="1" Text="{Binding DurationText}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </Grid>
            </StackPanel>

            <Border x:Name="FooterBar" Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="28,12">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,0,0,10">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center" Height="32">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource VolumeIcon}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.6" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"/>
                            <views:ListeningSlider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="1"
                                    Value="{Binding Volume, Mode=OneWay}" SmallChange="0.05" LargeChange="0.1" Margin="4,0,8,0"
                                    AutomationProperties.Name="Volume" ToolTip="Playback volume"
                                    PreviewMouseLeftButtonDown="Volume_MouseDown" PreviewMouseLeftButtonUp="Volume_MouseUp"
                                    PreviewKeyDown="Volume_KeyDown" PreviewKeyUp="Volume_KeyUp" ValueChanged="Volume_ValueChanged"
                                    LostKeyboardFocus="Volume_LostKeyboardFocus" AutomationValueCommitted="Volume_AutomationValueCommitted"/>
                            <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:P0}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <ComboBox x:Name="VisualizationPicker" Grid.Column="2" SelectedValuePath="Content"
                                  SelectedValue="{Binding Visualization, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Height="32" VerticalAlignment="Center" AutomationProperties.Name="Visualizer style" ToolTip="Visualizer style">
                            <ComboBoxItem Content="Ribbon"/><ComboBoxItem Content="Bars"/><ComboBoxItem Content="Off"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

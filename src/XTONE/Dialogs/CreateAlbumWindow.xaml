<Window x:Class="XTONE.Dialogs.CreateAlbumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create album" Width="520" Height="720" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FFFFFF" Foreground="#141414" FontFamily="{StaticResource AppFont}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Create a local album" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="A personal collection that points to your existing files." Foreground="#777A80" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="ALBUM TITLE" FontSize="10" FontWeight="SemiBold" Foreground="#777A80" Margin="0,0,0,7" />
                <TextBox x:Name="TitleBox" Style="{StaticResource TextInput}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="ARTIST" FontSize="10" FontWeight="SemiBold" Foreground="#777A80" Margin="0,0,0,7" />
                <TextBox x:Name="ArtistBox" Style="{StaticResource TextInput}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="COVER ART" FontSize="10" FontWeight="SemiBold" Foreground="#777A80" Margin="0,0,0,7" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Choose image" Click="ChooseCover_Click" Style="{StaticResource QuietButton}" BorderBrush="#E8E8E5" />
                <TextBlock x:Name="CoverPathText" Text="No cover selected" Foreground="#777A80" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="PRIVATE LINER NOTES" FontSize="10" FontWeight="SemiBold" Foreground="#777A80" Margin="0,0,0,7" />
            <TextBox x:Name="NotesBox" Height="72" Style="{StaticResource TextInput}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="ADD TRACKS" FontSize="10" FontWeight="SemiBold" Foreground="#777A80" VerticalAlignment="Center" />
                <TextBlock x:Name="TrackCountText" DockPanel.Dock="Right" Foreground="#777A80" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox x:Name="TrackList" Grid.Row="1" BorderBrush="#E8E8E5" BorderThickness="1" Padding="5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Cursor="Hand">
                            <StackPanel>
                                <TextBlock Text="{Binding Track.Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Track.Artist}" FontSize="11" Foreground="#777A80" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <DockPanel Grid.Row="5" Margin="0,20,0,0">
            <TextBlock x:Name="ValidationText" Foreground="#B54141" FontSize="12" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                <Button Content="Create album" Click="Create_Click" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
